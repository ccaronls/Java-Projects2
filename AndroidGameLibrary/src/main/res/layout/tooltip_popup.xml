<?xml version="1.0" encoding="utf-8"?><!-- res/layout/tooltip_popup_button.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tooltipContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:clipChildren="false"
    android:clipToOutline="false"
    android:clipToPadding="false"
    tools:background="#000">

    <TextView
        android:id="@+id/tooltipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:background="#000"
        android:text="Tooltip text could be quite long"
        android:layout_margin="?attr/tooltipTextMargin"
        android:textSize="?attr/tooltipTextSize"
        android:textColor="?attr/tooltipTextColor"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
