<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Dark.FullScreen"></style>

    <style name="Theme.AppCompat.Dark.FullScreen" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.AppCompat.Light.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Holo.Dialog.NoActionBar">
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="billing_purchases_tablerow">
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="billing_purchases_rowitem" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
    </style>

    <!-- Override in your applications 'AppTheme' -->
    <style name="TooltipPopupTheme">
        <item name="tooltipBackgroundColor">#6200EE</item>
        <item name="tooltipBorderColor">#FFFFFF</item>
        <item name="tooltipBorderWidth">2dp</item>
        <item name="tooltipCornerRadius">20dp</item>
        <item name="tooltipArrowWidth">24dp</item>
        <item name="tooltipArrowHeight">16dp</item>
        <item name="tooltipTextColor">#fff</item>
        <item name="tooltipTextSize">16sp</item>
        <item name="tooltipTextMargin">16dp</item>
    </style>

</resources>
